    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/slack-notify.sh",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
